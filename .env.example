# Copy to .env for local runs. Never commit real values.
PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASSWORD=change-me
DB_NAME=sampledb

# Connections per replica (pool size). 250 users with think time need far fewer.
DB_POOL_SIZE=10

# Rows inserted on first start (only when the table is empty).
SEED_ROWS=5000

# TLS to MySQL. Set DB_SSL_REJECT_UNAUTHORIZED=false only for a self-signed certificate.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
